{
  "name": "PaperTrades.ai: Claude vs Gemini vs ChatGPT",
  "short_name": "PaperTrades.ai",
  "description": "Three AIs trade head to head with pretend money and real prices, Oct 28 to Nov 28, 2026. Simulation only, not financial advice.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0b0a",
  "theme_color": "#0b0b0a",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://papertrades.ai/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
}
