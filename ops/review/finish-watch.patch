+++ b/.github/workflows/finish.yml
@@ -0,0 +1,59 @@
+name: Finish watch (after the finish only; starts the race runner until the result is final)
+# Nov 25 (all three AIs asked; ops/review/FINISH_CLAUDE_NOV25.md). After Sat Nov 28, 4:00 p.m. ET the race runner is still needed a few
+# times: the final scoring, bets on games that end after the finish, Claude's Sports total after such a bet, the last day's fingerprint.
+# Claude's hourly task, which starts the runner during the race, is switched off after the finish, and GitHub starts its own timers
+# only every hour or three. This watch looks at the records, starts ONE run of the race runner when something is waiting, and comes
+# back 12 minutes later by starting itself again. It ends by itself when nothing is waiting, at the latest Sun Nov 29, 6:00 a.m. ET.
+# Before the finish it does nothing. It writes no record. The rules are in ops/finish_watch.py.
+on:
+  schedule:
+    # Starters only: GitHub delivers its timers late or not at all, so there are many. Only one watch runs at a time (concurrency).
+    - cron: '1-59/5 21-23 28 11 *'    # Sat Nov 28, 4:01 to 6:56 p.m. ET, every 5 minutes
+    - cron: '6-59/10 0-10 29 11 *'    # Sat 7:06 p.m. to Sun 5:56 a.m. ET, every 10 minutes
+  workflow_dispatch:
+    inputs:
+      dry:
+        description: 'only say what it would do (nothing is started)'
+        type: boolean
+        default: false
+      now:
+        description: 'dry look only: pretend it is this moment (ISO with offset, like 2026-11-28T21:05:00+00:00)'
+        default: ''
+        required: false
+      hop:
+        description: 'set by the watch itself when it comes back'
+        default: ''
+        required: false
+      test_hops:
+        description: 'test of the mechanics only: start itself this many times, 20 seconds apart (the race is never looked at)'
+        default: ''
+        required: false
+permissions:
+  contents: read
+  actions: write   # to start the race runner (rivals.yml) and itself again
+# One watch at a time, and GitHub keeps only one waiting run per group, so a late timer and the watch's own next look never make two
+# chains. Dry looks and tests wait in their own group and can never hold up the real watch.
+concurrency:
+  group: ${{ (inputs.dry || inputs.test_hops) && 'finish-test' || 'finish-watch' }}
+  cancel-in-progress: false
+jobs:
+  watch:
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: main   # always the newest records
+          sparse-checkout: |
+            ops/finish_watch.py
+            ops/src/rivals.json
+            ops/src/bets.json
+          sparse-checkout-cone-mode: false
+      - name: Look, start the race runner if something is waiting, come back in 12 minutes
+        env:
+          GH_TOKEN: ${{ github.token }}
+          DRY: ${{ inputs.dry && '1' || '' }}
+          FAKE_NOW: ${{ inputs.now }}
+          HOP: ${{ inputs.hop }}
+          TEST_HOPS: ${{ inputs.test_hops }}
+        run: python3 ops/finish_watch.py
