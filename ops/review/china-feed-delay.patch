+# ---- China's feed runs 15 minutes behind (measured Nov 23): 20 minutes there, and never a price from before the session ----
+def test_china_price_15_minutes_old_is_live_but_never_one_from_before_the_session():
+    o, c, y = ts('2026-11-24T01:30:00+00:00'), ts('2026-11-24T07:00:00+00:00'), ts('2026-11-23T07:00:00+00:00')
+    at('2026-11-24T01:46:36+00:00'); q = ts('2026-11-24T01:31:36+00:00')   # as measured: the feed shows 9:31 a.m. Beijing, 900 s old
+    feed({'510300.SS': chart(4.02, q, [(q, 4.02)], (o, c))})
+    assert R.yahoo('510300.SS')[0] == 4.02 and not R.stale_quote('China', '510300.SS'), 'a 15-minute-old China price must count as live'
+    at('2026-11-24T02:10:00+00:00'); q = ts('2026-11-24T01:49:00+00:00')   # 21 minutes old: too old even there
+    feed({'510300.SS': chart(4.02, q, [(q, 4.02)], (o, c))})
+    R.yahoo('510300.SS')
+    assert R.stale_quote('China', '510300.SS'), 'a 21-minute-old China price must not fill'
+    at('2026-11-24T01:36:00+00:00'); q = ts('2026-11-24T01:26:00+00:00')   # a pre-open price only 10 minutes old: never used
+    feed({'159915.SZ': chart(2.5, q, [(q, 2.5)], (o, c))})
+    R.yahoo('159915.SZ')
+    assert R.stale_quote('China', '159915.SZ'), 'a China price from before the session must not fill, however recent'
+    at('2026-11-24T01:38:59+00:00')   # the previous close just after the open (as before)
+    feed({'510880.SS': chart(3.2, y, [(y - 60, 3.2)], (o, c))})
+    R.yahoo('510880.SS')
+    assert R.stale_quote('China', '510880.SS')
+    at('2026-11-24T15:00:00+00:00'); uo, uc, q = ts('2026-11-24T14:30:00+00:00'), ts('2026-11-24T21:00:00+00:00'), ts('2026-11-24T14:45:00+00:00')
+    feed({'SQQQ': chart(45.0, q, [(q, 45.0)], (uo, uc), 'USD')})   # everything else keeps its 3 minutes
+    R.yahoo('SQQQ')
