+
+
+def test_china_buys_follow_the_owners_switch_and_sells_fill():
+    saved = R.CN_NEW_BUYS
+    o, c = ts('2026-11-24T01:30:00+00:00'), ts('2026-11-24T07:00:00+00:00')
+    fx = {'USDCAD': 1.4, 'USDCNY': 7.1}
+    def books():
+        return {'China': {'cur': 'USD', 'cash': 50000.0, 'positions': {'510300.SS': {'qty': 32000, 'entry': 4.2, 'pcur': 'CNY', 'name': 'CSI 300 ETF',
+                                                                                   'opened_at': '2026-10-29T02:00:00Z', 'last': 4.02}}}}
+    def order(action, **k):
+        return dict({'experiment': 'China', 'action': action, 'symbol': '510300.SS'}, **k)
+    def refused(bk, od, word):
+        try:
+            R.execute('chatgpt', ['China'], bk, od, fx, {'trades': []})
+        except ValueError as e:
+            assert word in str(e), str(e)
+            return
+        raise AssertionError('was not refused: ' + word)
+    try:
+        at('2026-11-24T02:20:00+00:00'); q = ts('2026-11-24T02:05:00+00:00')   # 10:20 a.m. Beijing, the feed 15 minutes behind
+        feed({'510300.SS': chart(4.02, q, [(q, 4.02)], (o, c))})
+        R.CN_NEW_BUYS = False   # sells, stops and targets only
+        refused(books(), order('buy', amount=5000), 'new China buys are not filled')
+        bk = books()
+        R.execute('chatgpt', ['China'], bk, order('sell', fraction=1), fx, {'trades': []})   # the exit fills at the feed's newest price
+        assert '510300.SS' not in bk['China']['positions'] and abs(bk['China']['cash'] - (50000.0 + 32000 * 4.02 / 7.1)) < 0.01, bk
+        R.CN_NEW_BUYS = True    # buys too, from 10:00 a.m. Beijing
+        bk = books()
+        R.execute('chatgpt', ['China'], bk, order('buy', amount=5000), fx, {'trades': []})
+        assert bk['China']['positions']['510300.SS']['qty'] > 32000
+        at('2026-11-24T01:50:00+00:00'); q = ts('2026-11-24T01:35:00+00:00')   # 9:50 a.m. Beijing: inside the first 30 minutes
+        feed({'510300.SS': chart(4.02, q, [(q, 4.02)], (o, c))})
+        refused(books(), order('buy', amount=5000), 'first 30 minutes')
+        bk = books()
+        R.execute('chatgpt', ['China'], bk, order('sell', fraction=1), fx, {'trades': []})   # a sell is not held back
+        assert '510300.SS' not in bk['China']['positions']
+    finally:
+        R.CN_NEW_BUYS = saved
+
+
